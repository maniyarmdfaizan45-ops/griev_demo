# ==========================================
# GrievanceAI Environment Configuration Template
# Copy this file to .env and replace placeholders with real values for production.
# NEVER commit real secret keys, credentials, or production MongoDB URIs to source control.
# ==========================================

# Backend Server Configuration
PORT=5000
FLASK_ENV=production

# JWT Authentication Secret Key (Use a strong random secret in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password-in-production

# MongoDB Cloud Atlas Connection URI (Optional: Leave blank to use local SQLite fallback)
# Example: mongodb+srv://username:password@cluster.example.mongodb.net/grievance_db?retryWrites=true&w=majority
MONGO_URI=

# Frontend API Base URL Configuration (Used by Vite during build)
VITE_API_URL=http://localhost:5000/api
